  {
   "id": "9f848033-4d03-4772-9408-d82045b657f7",
   "name": "Build rows",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    900,
    100
   ],
   "parameters": {
    "jsCode": "const ins = $('Insights (daily x campaign)').first().json || {}; const bil = $('Billing charges').first().json || {}; const acc = $('Account').first().json || {};\nif (ins.error || !Array.isArray(ins.data)) return [{ json: { ok: false, error: (ins.error && ins.error.message) || 'No insights (token missing or no ads_read permission?)' } }];\nconst LEADS = ['lead', 'onsite_conversion.lead_grouped', 'offsite_conversion.fb_pixel_lead', 'onsite_conversion.messaging_conversation_started_7d'];\nconst rows = [['date', 'campaign_id', 'campaign', 'spend', 'impressions', 'clicks', 'leads', 'messages', 'updated']];\nconst now = $now.setZone('Asia/Manila').toFormat('yyyy-MM-dd HH:mm');\nins.data.forEach(r => { const a = r.actions || []; const g = t => a.filter(x => x.action_type === t).reduce((s, x) => s + Number(x.value || 0), 0);\n  rows.push([r.date_start, r.campaign_id, r.campaign_name, Number(r.spend || 0), Number(r.impressions || 0), Number(r.clicks || 0), Math.max(g('lead'), g('onsite_conversion.lead_grouped'), g('offsite_conversion.fb_pixel_lead')), g('onsite_conversion.messaging_conversation_started_7d'), now]); });\nconst card = (acc.funding_source_details && acc.funding_source_details.display_string) || '';\nconst brows = [['date', 'id', 'amount', 'status', 'reason', 'payment', 'updated']];\n(bil.data || []).filter(e => e.event_type === 'ad_account_billing_charge').forEach(e => { let x = {}; try { x = JSON.parse(e.extra_data || '{}'); } catch (err) {}\n  brows.push([DateTime.fromISO(e.event_time).setZone('Asia/Manila').toFormat('yyyy-MM-dd HH:mm'), x.transaction_id || '', Number(x.new_value || 0) / 100, 'charged', 'Account billed (' + (x.currency || 'PHP') + ')', card, now]); });\nreturn [{ json: { ok: true, n: rows.length - 1, nb: brows.length - 1, billing_error: bil.error ? bil.error.message : '', account: { name: acc.name, card, amount_spent: Number(acc.amount_spent || 0) / 100, balance: Number(acc.balance || 0) / 100, spend_cap: Number(acc.spend_cap || 0) / 100 },\n  clear: { ranges: [\"'Ad Spend'!A:I\", ...(brows.length > 1 ? [\"'Ad Billing'!A:G\"] : [])] },\n  write: { valueInputOption: 'RAW', data: [{ range: \"'Ad Spend'!A1\", values: rows }, ...(brows.length > 1 ? [{ range: \"'Ad Billing'!A1\", values: brows }] : [])] } } }];"
   }
  },
